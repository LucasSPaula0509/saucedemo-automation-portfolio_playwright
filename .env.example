# Variáveis de ambiente que sobrescrevem [tool.saucedemo] do pyproject.toml.
# Este arquivo é só documentação: o projeto não carrega .env automaticamente.
# Exporte as que quiser no terminal (bash: export CHAVE=valor; PowerShell: $env:CHAVE="valor").
BASE_URL=https://www.saucedemo.com
TIMEOUT_SECONDS=10
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080
SCREENSHOT_EVERY_STEP=false
PERF_LOGIN_PAGE_MAX_MS=3000
PERF_LOGIN_TO_INVENTORY_MAX_MS=2000
PERF_LCP_MAX_MS=2500
SECURITY_FAIL_ON_FINDINGS=false
